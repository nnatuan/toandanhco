		<script type="text/javascript">	
		function add_cart_detail(_id){
			var _qty = $("#number").val();
			add_cart(_id, _qty);
		}
		 function add_cart(_id,_qty){
              jQuery.post( "<?php echo base_url()?>thao-tac/mua-san-pham", { id_pro: _id, qty_pro: _qty })
              .done(function( data ) { 
              		location.href="<?php echo base_url()?>gio-hang";
              });	
          }
      </script>
